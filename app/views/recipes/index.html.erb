<h1>All Recipes</h1>

<h3>Recipes lovingly created by our community!</h3>
<div class="h3-underline"></div>

<style>
  .h3-underline {
    width: 100%;
    height: 2px;
    background-color: #ccc; /* The color of the line */
    margin-top: 10px; /* Space between the <h3> and the line */
    box-shadow: 0 2px 2px rgba(0, 0, 0, 0.1); /* Subtle shadow effect */
    margin-bottom: 10px;
  }

</style>


<div class="container d-flex justify-content-center mb-3">
<div class="row row-cols-3">
  <% @recipes.each do |recipe| %>
    <%= render partial: 'card', locals: { recipe: recipe } %>
  <% end %>
  </div>
</div>

